                <a href="https://OpenSimLab.org" target="_blank" class="text-blue-400 hover:text-blue-300 transition-colors font-medium">OpenSimLab.org</a>
            </p>
            <p class="mt-2 text-slate-500">
                <span class="en-text">Recreated interactively by Gemini</span><span class="th-text">สร้างสรรค์แบบจำลองอินเทอร์แอกทีฟโดย Gemini</span>
            </p>
        </div>
    </footer>

    <!-- =========================================================================
         JavaScript Logic (ระบบประมวลผล Anti-Sandbox MathJax และ Canvas)
         ========================================================================= -->
    <script>
        let currentLang = 'en';

        function switchLanguage() {
            const body = document.body;
            const toggleBox = document.getElementById('langToggleBtn');
            
            if (currentLang === 'en') {
                body.classList.remove('lang-en');
                body.classList.add('lang-th');
                toggleBox.classList.remove('lang-en-active');
                toggleBox.classList.add('lang-th-active');
                currentLang = 'th';
            } else {
                body.classList.remove('lang-th');
                body.classList.add('lang-en');
                toggleBox.classList.remove('lang-th-active');
                toggleBox.classList.add('lang-en-active');
                currentLang = 'en';
            }
            runAllCalculations();
        }

        // ==========================================
        // 1. Math String Builder (หลบการตัดคำและแปลภาษาของ Google Sites/Chrome)
        // ==========================================
        let mathJaxQueue = Promise.resolve();

        function setMath(elementId, texString, isDisplay = false) {
            const el = document.getElementById(elementId);
            if (!el) return;
            
            el.setAttribute('translate', 'no');
            el.classList.add('notranslate');
            
            el.innerHTML = isDisplay ? `$$${texString}$$` : `\\(${texString}\\)`;
            
            if (window.MathJax && window.MathJax.typesetPromise) {
                mathJaxQueue = mathJaxQueue.then(() => {
                    MathJax.typesetClear([el]);
                    return MathJax.typesetPromise([el]);
                }).catch(err => console.log(err));
            }
        }

        // ==========================================
        // 2. Main Calculation & Equation Logic
        // ==========================================
        let simCurrentV2 = 0, simCurrentP1 = 0;
        let currentA1 = 3, currentA2 = 1.5, currentV1 = 2, currentP2 = 101300, currentH1 = 0, currentH2 = 4;
        
        function runAllCalculations() {
            try {
                const bs = String.fromCharCode(92);
                const nl = bs + bs; 

                // ----------------------------------------
                // Static Texts Setup
                // ----------------------------------------
                setMath('math-proof-0', `W = ${bs}Delta E_k + ${bs}Delta E_p`);
                setMath('math-proof-0-th', `W = ${bs}Delta E_k + ${bs}Delta E_p`);
                setMath('math-proof-1', `P_1V - P_2V = ${bs}left(${bs}frac{1}{2}mv_2^2 - ${bs}frac{1}{2}mv_1^2${bs}right) + (mgh_2 - mgh_1)`, true);
                setMath('math-proof-2', `V`);
                setMath('math-proof-3', `${bs}rho = ${bs}frac{m}{V}`);
                setMath('math-proof-2-th', `V`);
                setMath('math-proof-3-th', `${bs}rho = ${bs}frac{m}{V}`);
                setMath('math-proof-4', `P_1 - P_2 = ${bs}left(${bs}frac{1}{2}${bs}rho v_2^2 - ${bs}frac{1}{2}${bs}rho v_1^2${bs}right) + (${bs}rho g h_2 - ${bs}rho g h_1)`, true);
                setMath('math-proof-5', `P_1 + ${bs}frac{1}{2}${bs}rho v_1^2 + ${bs}rho g h_1 = P_2 + ${bs}frac{1}{2}${bs}rho v_2^2 + ${bs}rho g h_2`, true);
                
                setMath('math-var-p', `P`); setMath('math-var-p-th', `P`);
                setMath('math-var-rho', `${bs}rho`); setMath('math-var-rho-th', `${bs}rho`);
                setMath('math-var-v', `v`); setMath('math-var-v-th', `v`);
                setMath('math-var-h', `h`); setMath('math-var-h-th', `h`);
                
                setMath('math-sim-water', `${bs}rho = 1000 ${bs}text{ kg/m}^3, g = 9.81 ${bs}text{ m/s}^2`);
                setMath('math-sim-water-th', `${bs}rho = 1000 ${bs}text{ kg/m}^3, g = 9.81 ${bs}text{ m/s}^2`);
                
                setMath('math-lbl-a1', `A_1`); setMath('math-lbl-a1-th', `A_1`);
                setMath('math-lbl-a2', `A_2`); setMath('math-lbl-a2-th', `A_2`);
                setMath('math-lbl-v1', `v_1`); setMath('math-lbl-v1-th', `v_1`);
                
                setMath('math-lbl-p2', `P_2`); setMath('math-lbl-p2-th', `P_2`);
                
                setMath('math-lbl-h1', `h_1`); setMath('math-lbl-h1-th', `h_1`);
                setMath('math-lbl-h2', `h_2`); setMath('math-lbl-h2-th', `h_2`);
                setMath('math-res-v2', `v_2`); setMath('math-res-v2-th', `v_2`);
                
                setMath('math-res-dp', `(${bs}Delta P)`); setMath('math-res-dp-th', `(${bs}Delta P)`);

                setMath('math-ex1-water', `${bs}rho = 1000 ${bs}text{ kg/m}^3, g = 9.81 ${bs}text{ m/s}^2`);
                setMath('math-e1-v2', `(v_2)`);
                setMath('math-e1-dp', `(${bs}Delta P)`);
                setMath('math-ex1-dp-q', `(${bs}Delta P = P_1 - P_2)`); setMath('math-ex1-dp-q-th', `(${bs}Delta P = P_1 - P_2)`);
                
                setMath('math-ex2-g', `g = 9.81 ${bs}text{ m/s}^2`);
                setMath('math-e2-a1', `P_1 = P_2 = P_{atm}`);
                setMath('math-e2-a2', `v_1 ${bs}approx 0`);
                setMath('math-e2-a3', `h_2 = 0`);
                
                setMath('math-ex3-air', `${bs}rho_{air} = 1.2 ${bs}text{ kg/m}^3`);
                setMath('math-e3-dp', `(${bs}Delta P)`);
                setMath('math-e3-f', `(F)`);

                // ----------------------------------------
                // Interactive Simulation Logic
                // ----------------------------------------
                const elA1 = document.getElementById('simA1');
                const sA1 = elA1 ? Number(elA1.value) || 3 : 3;
                const elA2 = document.getElementById('simA2');
                const sA2 = elA2 ? Number(elA2.value) || 1.5 : 1.5;
                const elV1 = document.getElementById('simV1');
                const sV1 = elV1 ? Number(elV1.value) || 2 : 2;
                
                const elP2 = document.getElementById('simP2');
                const sP2 = elP2 ? Number(elP2.value) * 1000 || 101000 : 101000;
                
                const elH1 = document.getElementById('simH1');
                const sH1_raw = elH1 ? Number(elH1.value) : 0;
                const sH1 = isNaN(sH1_raw) ? 0 : sH1_raw;
                
                const elH2 = document.getElementById('simH2');
                const sH2_raw = elH2 ? Number(elH2.value) : 4;
                const sH2 = isNaN(sH2_raw) ? 4 : sH2_raw;
                
                currentA1 = sA1; currentA2 = sA2; currentV1 = sV1; currentP2 = sP2; currentH1 = sH1; currentH2 = sH2;

                const rho = 1000;
                const g = 9.81;

                const sV2 = (sA1 / sA2) * sV1;
                simCurrentV2 = sV2;
                
                // คำนวณความต่างศักย์ความดัน dP = P1 - P2
                const term1 = 0.5 * rho * (Math.pow(sV2, 2) - Math.pow(sV1, 2));
                const term2 = rho * g * (sH2 - sH1);
                const sDP = term1 + term2; 
                
                const sP1 = sP2 + sDP;
                simCurrentP1 = sP1;

                if(document.getElementById('lblA1')) document.getElementById('lblA1').innerText = sA1.toFixed(1);
                if(document.getElementById('lblA2')) document.getElementById('lblA2').innerText = sA2.toFixed(1);
                if(document.getElementById('lblV1')) document.getElementById('lblV1').innerText = sV1.toFixed(1);
                if(document.getElementById('lblP2')) document.getElementById('lblP2').innerText = (sP2/1000).toFixed(0);
                if(document.getElementById('lblH1')) document.getElementById('lblH1').innerText = sH1.toFixed(1);
                if(document.getElementById('lblH2')) document.getElementById('lblH2').innerText = sH2.toFixed(1);

                setMath('live-calc-v2', `${bs}begin{aligned} A_1v_1 &= A_2v_2 ${nl} v_2 &= ${bs}frac{A_1}{A_2} v_1 ${nl} v_2 &= ${bs}frac{${sA1.toFixed(1)}}{${sA2.toFixed(1)}} (${sV1.toFixed(1)}) = ${bs}mathbf{${sV2.toFixed(2)}${bs}text{ m/s}} ${bs}end{aligned}`, true);
                
                setMath('live-calc-dp', `${bs}begin{aligned} P_1 + ${bs}frac{1}{2}${bs}rho v_1^2 + ${bs}rho g h_1 &= P_2 + ${bs}frac{1}{2}${bs}rho v_2^2 + ${bs}rho g h_2 ${nl} P_1 - P_2 &= ${bs}frac{1}{2}${bs}rho(v_2^2 - v_1^2) + ${bs}rho g(h_2 - h_1) ${nl} ${bs}Delta P &= ${bs}frac{1}{2}(1000)(${sV2.toFixed(2)}^2 - ${sV1.toFixed(1)}^2) + 1000(9.81)(${sH2.toFixed(1)} - ${sH1.toFixed(1)}) ${nl} ${bs}Delta P &= ${term1 >= 0 ? '' : '-'}${Math.abs(term1).toFixed(1)} ${term2 >= 0 ? '+' : '-'} ${Math.abs(term2).toFixed(1)} ${nl} ${bs}Delta P &= ${sDP.toFixed(1)}${bs}text{ Pa} = ${bs}mathbf{${(sDP/1000).toFixed(2)}${bs}text{ kPa}} ${bs}end{aligned}`, true);

                if(document.getElementById('resV2')) document.getElementById('resV2').innerHTML = `${sV2.toFixed(2)} <span class="text-base font-normal text-blue-400">m/s</span>`;
                if(document.getElementById('resDP')) document.getElementById('resDP').innerHTML = `${(sDP/1000).toFixed(2)} <span id="resDPUnit" class="text-base font-normal text-blue-400">kPa</span>`;
                
                const resDPContainer = document.getElementById('resDPContainer');
                const resDPHeader = document.getElementById('resDPHeader');
                const resDPInnerBox = document.getElementById('resDPInnerBox');
                const resDPLabel = document.getElementById('resDPLabel');
                const resDP = document.getElementById('resDP');
                const resDPUnit = document.getElementById('resDPUnit');
                const liveCalcDP = document.getElementById('live-calc-dp');

                if (resDPContainer) {
                    if(sP1 < 0) {
                        resDPContainer.className = "bg-white p-6 rounded-2xl border border-red-200 shadow-sm flex flex-col items-center transition-colors duration-300";
                        resDPHeader.className = "font-bold text-red-800 mb-4 text-sm uppercase tracking-widest border-b border-red-200 pb-3 w-full text-center transition-colors";
                        liveCalcDP.className = "text-red-600 text-base math-wrapper notranslate w-full transition-colors";
                        resDPInnerBox.className = "mt-6 pt-5 border-t border-red-100 text-center bg-red-50 rounded-xl p-4 w-full md:w-auto self-center transition-colors duration-300";
                        resDPLabel.className = "text-xs text-red-500 uppercase tracking-widest font-bold mb-2 transition-colors";
                        resDP.className = "text-4xl font-black text-red-600 transition-colors";
                        if(resDPUnit) resDPUnit.className = "text-lg font-semibold text-red-400";
                    } else {
                        resDPContainer.className = "bg-white p-6 rounded-2xl border border-blue-100 shadow-sm flex flex-col items-center transition-colors duration-300";
                        resDPHeader.className = "font-bold text-blue-800 mb-4 text-sm uppercase tracking-widest border-b border-blue-100 pb-3 w-full text-center transition-colors";
                        liveCalcDP.className = "text-blue-700 text-base math-wrapper notranslate w-full transition-colors";
                        resDPInnerBox.className = "mt-6 pt-5 border-t border-blue-100 text-center bg-blue-50/50 rounded-xl p-4 w-full md:w-auto self-center transition-colors duration-300";
                        resDPLabel.className = "text-xs text-blue-500 uppercase tracking-widest font-bold mb-2 transition-colors";
                        resDP.className = "text-4xl font-black text-blue-700 transition-colors";
                        if(resDPUnit) resDPUnit.className = "text-lg font-semibold text-blue-400";
                    }
                }

                // ----------------------------------------
                // Example 1 Logic (dP)
                // ----------------------------------------
                const inEx1A1 = document.getElementById('inEx1A1');
                const e1A1 = inEx1A1 ? Number(inEx1A1.value) || 3 : 3;
                const inEx1A2 = document.getElementById('inEx1A2');
                const e1A2 = inEx1A2 ? Number(inEx1A2.value) || 1.5 : 1.5; 
                const inEx1V1 = document.getElementById('inEx1V1');
                const e1V1 = inEx1V1 ? Number(inEx1V1.value) || 2 : 2;
                const inEx1H1 = document.getElementById('inEx1H1');
                const e1H1 = inEx1H1 ? Number(inEx1H1.value) || 0 : 0;
                const inEx1H2 = document.getElementById('inEx1H2');
                const e1H2 = inEx1H2 ? Number(inEx1H2.value) || 0 : 0;

                const e1V2 = (e1A1 / (e1A2===0?0.0001:e1A2)) * e1V1; 
                const e1T1 = 0.5 * rho * (Math.pow(e1V1, 2) - Math.pow(e1V2, 2));
                const e1T2 = rho * g * (e1H1 - e1H2);
                const e1DP = e1T1 + e1T2; 

                setMath('solEx1Eq1', `${bs}begin{aligned} A_1 v_1 &= A_2 v_2 ${nl} v_2 &= ${bs}frac{A_1}{A_2} v_1 ${nl} v_2 &= ${bs}frac{${e1A1}}{${e1A2}} (${e1V1}) = ${bs}mathbf{${e1V2.toFixed(2)}${bs}text{ m/s}} ${bs}end{aligned}`, true);
                setMath('solEx1Eq2', `${bs}begin{aligned} P_1 + ${bs}frac{1}{2}${bs}rho v_1^2 + ${bs}rho g h_1 &= P_2 + ${bs}frac{1}{2}${bs}rho v_2^2 + ${bs}rho g h_2 ${nl} P_1 - P_2 &= ${bs}frac{1}{2}${bs}rho (v_2^2 - v_1^2) + ${bs}rho g(h_2 - h_1) ${nl} ${bs}Delta P &= ${bs}frac{1}{2}(1000)(${e1V2.toFixed(2)}^2 - ${e1V1.toFixed(1)}^2) + (1000)(9.81)(${e1H2} - ${e1H1}) ${nl} ${bs}Delta P &= ${-e1T1 >= 0 ? '' : '-'}${Math.abs(e1T1).toFixed(1)} ${-e1T2 >= 0 ? '+' : '-'} ${Math.abs(e1T2).toFixed(1)} ${nl} ${bs}Delta P &= ${-e1DP.toFixed(1)}${bs}text{ Pa} = ${bs}mathbf{${(-e1DP/1000).toFixed(2)}${bs}text{ kPa}} ${bs}end{aligned}`, true);

                // ----------------------------------------
                // Example 2 Logic
                // ----------------------------------------
                const inEx2H = document.getElementById('inEx2H');
                const e2H = inEx2H ? Number(inEx2H.value) || 0 : 0;
                const e2V = Math.sqrt(2 * g * e2H);
                
                setMath('math-e2-a4', `h_1 = ${e2H}${bs}text{ m}`);
                setMath('solEx2Eq1', `P_1 + ${bs}frac{1}{2}${bs}rho v_1^2 + ${bs}rho g h_1 = P_2 + ${bs}frac{1}{2}${bs}rho v_2^2 + ${bs}rho g h_2`, true);
                setMath('solEx2Eq2', `${bs}begin{aligned} ${bs}rho g h_1 &= ${bs}frac{1}{2}${bs}rho v_2^2 ${nl} v_2 &= ${bs}sqrt{2 g h_1} ${nl} v_2 &= ${bs}sqrt{2(9.81)(${e2H})} = ${bs}mathbf{${e2V.toFixed(2)}${bs}text{ m/s}} ${bs}end{aligned}`, true);

                // ----------------------------------------
                // Example 3 Logic
                // ----------------------------------------
                const inEx3V1 = document.getElementById('inEx3V1');
                const inEx3V2 = document.getElementById('inEx3V2');
                const inEx3A = document.getElementById('inEx3A');
                
                const e3V1 = inEx3V1 ? Number(inEx3V1.value) || 0 : 0;
                const e3V2 = inEx3V2 ? Number(inEx3V2.value) || 0 : 0;
                const e3A = inEx3A ? Number(inEx3A.value) || 0 : 0;
                const rhoAir = 1.2;

                const e3DP = 0.5 * rhoAir * (Math.pow(e3V1, 2) - Math.pow(e3V2, 2));
                const e3F = e3DP * e3A;

                setMath('solEx3Eq1', `${bs}begin{aligned} P_{bottom} - P_{top} &= ${bs}frac{1}{2}${bs}rho_{air} (v_{top}^2 - v_{bottom}^2) ${nl} ${bs}Delta P &= ${bs}frac{1}{2}(1.2)(${e3V1}^2 - ${e3V2}^2) ${nl} ${bs}Delta P &= 0.6(${Math.pow(e3V1, 2)} - ${Math.pow(e3V2, 2)}) ${nl} ${bs}Delta P &= ${e3DP.toFixed(1)}${bs}text{ Pa} ${bs}end{aligned}`, true);
                setMath('solEx3Eq2', `${bs}begin{aligned} F &= ${bs}Delta P ${bs}times A ${nl} F &= ${e3DP.toFixed(1)} ${bs}times ${e3A} ${nl} F &= ${bs}mathbf{${e3F.toFixed(1)}${bs}text{ N}} ${bs}end{aligned}`, true);

            } catch (e) {
                console.error("Calculation Error:", e);
            }
        }

        // ==========================================
        // 3. Canvas Simulation 
        // ==========================================
        let canvas = document.getElementById('pipeCanvas');
        let ctx;
        let particles = [];
        const numParticles = 120;
        let animationFrameId;

        function initParticles() {
            particles = [];
            let w = canvas.logicalWidth || canvas.width || 800;
            for (let i = 0; i < numParticles; i++) {
                particles.push({
                    x: Math.random() * w,
                    y: 0,
                    relY: Math.random() * 2 - 1 
                });
            }
        }

        function resizeCanvas() {
            const container = document.getElementById('sim-container');
            if (!container || !ctx) return;
            
            const rect = container.getBoundingClientRect();
            let w = rect.width;
            let h = rect.height;
            
            if (w === 0 || h === 0) {
                w = container.clientWidth || 800;
                h = container.clientHeight || 450;
            }
            if (w === 0) w = 800;
            if (h === 0) h = 450;
            
            const dpr = window.devicePixelRatio || 1;
            
            canvas.width = w * dpr;
            canvas.height = h * dpr;
            canvas.style.width = `${w}px`;
            canvas.style.height = `${h}px`;
            
            ctx.setTransform(1, 0, 0, 1, 0, 0);
            ctx.scale(dpr, dpr);
            
            canvas.logicalWidth = w;
            canvas.logicalHeight = h;

            initParticles();
        }

        function drawLoop() {
            if (!ctx) return;
            
            const w = canvas.logicalWidth || 800;
            const h = canvas.logicalHeight || 450; 
            
            ctx.clearRect(0, 0, w, h);
            
            const visualScaleH = 12; 
            const scaleArea = 8; 
            
            const h1 = currentA1 * scaleArea;
            const h2 = currentA2 * scaleArea;

            const topY1 = - (currentH1 * visualScaleH) - h1 - 130; 
            const topY2 = - (currentH2 * visualScaleH) - h2 - 130;
            const topY = Math.min(topY1, topY2);
            const bottomY = 20; 
            
            const totalHeight = bottomY - topY;
            const datumY = (h - totalHeight) / 2 - topY; 
            
            const cY1 = datumY - (currentH1 * visualScaleH);
            const cY2 = datumY - (currentH2 * visualScaleH);
            
            const transitionStartX = w * 0.35;
            const transitionEndX = w * 0.65;

            // Datum Line
            ctx.beginPath();
            ctx.moveTo(0, datumY);
            ctx.lineTo(w, datumY);
            ctx.strokeStyle = '#9ca3af';
            ctx.lineWidth = 1.5;
            ctx.setLineDash([5, 5]);
            ctx.stroke();
            ctx.setLineDash([]);
            
            ctx.fillStyle = '#64748b';
            ctx.font = '12px "Sarabun", sans-serif';
            ctx.textAlign = 'right';
            ctx.fillText(currentLang === 'en' ? 'Datum (h=0)' : 'ระดับอ้างอิง (h=0)', w - 20, datumY - 10);

            // Fluid Pipe Body
            ctx.beginPath();
            ctx.moveTo(0, cY1 - h1);
            ctx.lineTo(transitionStartX, cY1 - h1);
            ctx.bezierCurveTo(transitionStartX + w*0.1, cY1 - h1, transitionEndX - w*0.1, cY2 - h2, transitionEndX, cY2 - h2);
            ctx.lineTo(w, cY2 - h2);
            ctx.lineTo(w, cY2 + h2);
            ctx.lineTo(transitionEndX, cY2 + h2);
            ctx.bezierCurveTo(transitionEndX - w*0.1, cY2 + h2, transitionStartX + w*0.1, cY1 + h1, transitionStartX, cY1 + h1);
            ctx.lineTo(0, cY1 + h1);
            ctx.closePath();
            
            let gradient = ctx.createLinearGradient(0, 0, 0, h);
            gradient.addColorStop(0, "#bfdbfe");
            gradient.addColorStop(1, "#93c5fd");
            ctx.fillStyle = gradient;
            ctx.fill();

            // Pipe Borders
            ctx.lineWidth = 3;
            ctx.strokeStyle = '#1e3a8a';
            ctx.lineJoin = 'round';
            ctx.lineCap = 'round';
            
            ctx.beginPath();
            ctx.moveTo(0, cY1 - h1);
            ctx.lineTo(transitionStartX, cY1 - h1);
            ctx.bezierCurveTo(transitionStartX + w*0.1, cY1 - h1, transitionEndX - w*0.1, cY2 - h2, transitionEndX, cY2 - h2);
            ctx.lineTo(w, cY2 - h2);
            ctx.stroke();
            
            ctx.beginPath();
            ctx.moveTo(0, cY1 + h1);
            ctx.lineTo(transitionStartX, cY1 + h1);
            ctx.bezierCurveTo(transitionStartX + w*0.1, cY1 + h1, transitionEndX - w*0.1, cY2 + h2, transitionEndX, cY2 + h2);
            ctx.lineTo(w, cY2 + h2);
            ctx.stroke();

            // Analog Pressure Gauge
            function drawPressureGauge(x, pipeCenterY, pipeRadius, pressurePa, label) {
                const p_kPa = pressurePa / 1000;
                const gaugeRadius = 35;
                const gaugeY = pipeCenterY - pipeRadius - gaugeRadius - 15;

                // Stand
                ctx.beginPath();
                ctx.moveTo(x - 5, pipeCenterY - pipeRadius);
                ctx.lineTo(x - 5, gaugeY + gaugeRadius);
                ctx.lineTo(x + 5, gaugeY + gaugeRadius);
                ctx.lineTo(x + 5, pipeCenterY - pipeRadius);
                ctx.fillStyle = '#64748b';
                ctx.fill();
                ctx.strokeStyle = '#334155';
                ctx.lineWidth = 1;
                ctx.stroke();

                // Value Text (Above gauge)
                ctx.fillStyle = '#0f172a';
                ctx.font = 'bold 14px "Sarabun", sans-serif';
                ctx.textAlign = 'center';
                ctx.fillText(`${label} = ${p_kPa.toFixed(0)} kPa`, x, gaugeY - gaugeRadius - 12);

                // Outer Shell
                ctx.beginPath();
                ctx.arc(x, gaugeY, gaugeRadius, 0, Math.PI * 2);
                ctx.fillStyle = '#94a3b8';
                ctx.fill();
                ctx.lineWidth = 3;
                ctx.strokeStyle = '#475569';
                ctx.stroke();

                // Inner Dial
                ctx.beginPath();
                ctx.arc(x, gaugeY, gaugeRadius - 4, 0, Math.PI * 2);
                ctx.fillStyle = '#ffffff';
                ctx.fill();

                // Tick Marks (0 to 1000 kPa)
                ctx.save();
                ctx.translate(x, gaugeY);
                for(let i = -135; i <= 135; i += 13.5) { 
                    ctx.rotate(i * Math.PI / 180);
                    ctx.beginPath();
                    ctx.moveTo(0, -gaugeRadius + 4);
                    
                    if (i % 27 === 0) {
                        ctx.lineTo(0, -gaugeRadius + 12); 
                        ctx.strokeStyle = '#1e293b';
                        ctx.lineWidth = 2;
                    } else {
                        ctx.lineTo(0, -gaugeRadius + 8); 
                        ctx.strokeStyle = '#94a3b8';
                        ctx.lineWidth = 1;
                    }
                    ctx.stroke();
                    ctx.rotate(-i * Math.PI / 180);
                }

                // Needle
                let pClamped = Math.max(0, Math.min(p_kPa, 1000));
                let angle = -135 + (pClamped / 1000) * 270;
                
                ctx.rotate(angle * Math.PI / 180);
                ctx.beginPath();
                ctx.moveTo(-2, 5);
                ctx.lineTo(2, 5);
                ctx.lineTo(1, -gaugeRadius + 10);
                ctx.lineTo(-1, -gaugeRadius + 10);
                ctx.fillStyle = p_kPa < 0 ? '#b91c1c' : '#dc2626'; 
                ctx.fill();
                ctx.rotate(-angle * Math.PI / 180); 

                // Pin
                ctx.beginPath();
                ctx.arc(0, 0, 4, 0, Math.PI * 2);
                ctx.fillStyle = '#1e293b';
                ctx.fill();
                ctx.restore(); 

                // Unit
                ctx.fillStyle = '#64748b';
                ctx.font = 'bold 9px sans-serif';
                ctx.textAlign = 'center';
                ctx.fillText('kPa', x, gaugeY + 15);
            }
            
            drawPressureGauge(w * 0.15, cY1, h1, simCurrentP1, 'P₁');
            drawPressureGauge(w * 0.85, cY2, h2, currentP2, 'P₂');

            // Height Markers
            function drawHeightMarker(x, pipeCenterY, hVal) {
                const heightValue = Number(hVal) || 0; 
                if (Math.abs(pipeCenterY - datumY) < 1) {
                    ctx.fillStyle = '#8b5cf6';
                    ctx.fillText(`h = 0.0 m`, x + 40, datumY + 5);
                    return;
                }
                
                ctx.beginPath();
                ctx.moveTo(x, pipeCenterY);
                ctx.lineTo(x, datumY);
                ctx.strokeStyle = '#8b5cf6';
                ctx.lineWidth = 2;
                ctx.stroke();
                
                ctx.beginPath();
                ctx.moveTo(x, pipeCenterY);
                ctx.lineTo(x - 4, pipeCenterY + (pipeCenterY < datumY ? 6 : -6));
                ctx.lineTo(x + 4, pipeCenterY + (pipeCenterY < datumY ? 6 : -6));
                ctx.fillStyle = '#8b5cf6';
                ctx.fill();
                
                ctx.beginPath();
                ctx.moveTo(x, datumY);
                ctx.lineTo(x - 4, datumY + (pipeCenterY < datumY ? -6 : 6));
                ctx.lineTo(x + 4, datumY + (pipeCenterY < datumY ? -6 : 6));
                ctx.fill();

                ctx.fillText(`h = ${heightValue.toFixed(1)} m`, x + 40, (pipeCenterY + datumY) / 2 + 5);
            }
            drawHeightMarker(w * 0.25, cY1, currentH1);
            drawHeightMarker(w * 0.75, cY2, currentH2);

            // Particles
            ctx.fillStyle = '#2563eb';
            particles.forEach(p => {
                let currentH, currentV, currentCY;
                
                if (p.x < transitionStartX) {
                    currentH = h1;
                    currentV = currentV1;
                    currentCY = cY1;
                } else if (p.x > transitionEndX) {
                    currentH = h2;
                    currentV = simCurrentV2;
                    currentCY = cY2;
                } else {
                    const t = (p.x - transitionStartX) / (transitionEndX - transitionStartX);
                    const smoothT = t * t * (3 - 2 * t);
                    currentH = h1 + (h2 - h1) * smoothT; 
                    currentV = currentV1 * (h1 / currentH); 
                    currentCY = cY1 + (cY2 - cY1) * smoothT;
                }

                p.x += currentV * 0.4; // 0.4 For slower flowing visualization
                p.y = currentCY + (p.relY * currentH * 0.85);

                if (p.x > w) {
                    p.x = 0;
                    p.relY = Math.random() * 2 - 1;
                }

                ctx.beginPath();
                ctx.arc(p.x, p.y, 1.5, 0, Math.PI * 2);
                ctx.fill();
            });

            // Labels in Canvas
            ctx.fillStyle = '#1e293b'; 
            ctx.font = 'bold 15px "Sarabun", sans-serif';
            ctx.textAlign = 'center';
            
            let textLeftX = w * 0.15;
            ctx.fillText(`A₁ = ${currentA1.toFixed(1)} m²`, textLeftX, cY1 - h1 - 15);
            ctx.fillText(`v₁ = ${currentV1.toFixed(1)} m/s`, textLeftX, cY1 + h1 + 25);
            
            let textRightX = w * 0.85;
            ctx.fillText(`A₂ = ${currentA2.toFixed(1)} m²`, textRightX, cY2 - h2 - 15);
            ctx.fillText(`v₂ = ${simCurrentV2.toFixed(2)} m/s`, textRightX, cY2 + h2 + 25);

            // Cavitation Warning
            if (simCurrentP1 < 0) {
                const boxW = Math.min(w * 0.95, 540);
                const boxH = 85;
                const boxX = (w - boxW) / 2;
                const boxY = 10;
                
                ctx.fillStyle = 'rgba(254, 226, 226, 0.95)';
                ctx.strokeStyle = '#ef4444';
                ctx.lineWidth = 2;
                
                ctx.beginPath();
                ctx.rect(boxX, boxY, boxW, boxH);
                ctx.fill();
                ctx.stroke();
                
                ctx.fillStyle = '#b91c1c';
                ctx.textAlign = 'center';
                
                if (currentLang === 'en') {
                    ctx.font = 'bold 15px "Sarabun", sans-serif';
                    ctx.fillText("⚠️ Warning: Negative Pressure Calculated (P₁ < 0)!", w / 2, boxY + 25);
                    ctx.font = '13px "Sarabun", sans-serif';
                    ctx.fillText("Math: Kinetic/Potential energy is so high it forces Static Pressure to be negative to balance the equation.", w / 2, boxY + 48);
                    ctx.fillText("Reality: Absolute pressure cannot be negative. The fluid vaporizes into bubbles, causing 'Cavitation'.", w / 2, boxY + 68);
                } else {
                    ctx.font = 'bold 16px "Sarabun", sans-serif';
                    ctx.fillText("⚠️ คำเตือน: ความดันคำนวณได้ค่าติดลบ (P₁ < 0)!", w / 2, boxY + 25);
                    ctx.font = '14px "Sarabun", sans-serif';
                    ctx.fillText("คณิตศาสตร์: ความเร็ว/ความสูงดึงพลังงานไปหมด ความดันสถิตจึงต้องติดลบเพื่อรักษาสมดุลสมการแบร์นูลลี", w / 2, boxY + 48);
                    ctx.fillText("ความจริง: ความดันสัมบูรณ์ติดลบไม่ได้ น้ำจะกลายเป็นไอเรียกว่า 'คาวิเตชัน' (Cavitation) ทำให้ท่อพังได้", w / 2, boxY + 68);
                }
            }

            animationFrameId = requestAnimationFrame(drawLoop);
        }

        // ==========================================
        // 5. Initializations
        // ==========================================
        let isStarted = false;
        
        function initApp() {
            if(isStarted) return;
            isStarted = true;
            
            runAllCalculations();

            const container = document.getElementById('sim-container');
            try {
                canvas = document.getElementById('pipeCanvas');
                ctx = canvas.getContext('2d');
                
                if(window.ResizeObserver) {
                    new ResizeObserver(() => resizeCanvas()).observe(container);
                } else {
                    window.addEventListener('resize', resizeCanvas);
                }

                resizeCanvas();
                drawLoop();
            } catch (e) {
                console.error("Canvas init failed:", e);
            }
        }

        window.addEventListener('load', () => {
            let checkKatex = setInterval(() => {
                if (window.MathJax && window.MathJax.typesetPromise) {
                    clearInterval(checkKatex);
                    initApp();
                }
            }, 100);

            setTimeout(() => {
                clearInterval(checkKatex);
                if (!isStarted) initApp();
            }, 5000);
        });

    </script>
</body>
</html>
